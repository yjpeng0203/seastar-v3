{
  "organizer": {
    "raw_data_dir": "./runtime/sample_raw",
    "decoder_bin": "../../build/decoder",
    "decoder_config": "../../cfg/config.json",
    "hadd_bin": "hadd",
    "root_bin": "root",
    "backend": "auto",
    "csv_mirror_dir": "./runtime/sample_csv",
    "output_root": "./runtime/organized",
    "work_dir": "./runtime/organized/.organizer_work",
    "layout": "group",
    "board_map": {
      "0": "G0",
      "1": "G1",
      "2": "G2",
      "3": "G3",
      "4": "G4",
      "5": "G5",
      "6": "G6"
    },
    "link_mode": "copy",
    "readonly_protect": true,
    "settle_seconds": 1.0,
    "poll_seconds": 3.0,
    "csv_margin_seconds": 60.0,
    "csv_sync_wait_seconds": 2.0,
    "nice_increment": 10,
    "hadd_batch_size": 64
  },
  "monitors": {
    "bind_host": "127.0.0.1",
    "fee_port": 8765,
    "ana_port": 8766
  }
}
